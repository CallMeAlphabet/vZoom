{
  "schemaVersion": 1,
  "id": "vzoom",
  "version": "${version}",
  "name": "vZoom",
  "description": "Infinite, smooth cinematic zoom. Hold the zoom key (default C) and scroll the mouse wheel to adjust the zoom depth with no fixed limits.",
  "authors": ["Vextoly"],
  "contact": {
    "homepage": "https://codeberg.org/Vextoly"
  },
  "license": "zlib",
  "environment": "client",
  "entrypoints": {
    "client": ["com.vzoom.client.VZoomClient"],
    "modmenu": ["com.vzoom.client.config.ModMenuIntegration"]
  },
  "mixins": ["vzoom.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": ">=1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
