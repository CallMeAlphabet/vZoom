{
  "schemaVersion": 1,
  "id": "vzoom",
  "version": "${version}",
  "name": "vZoom",
  "description": "Infinite, smooth cinematic zoom. Hold the zoom key (default C) and scroll the mouse wheel to adjust the zoom depth with no fixed limits.",
  "authors": [
    "Vextoly",
    "ItzAlphabet"
  ],
  "contact": {
    "homepage": "https://github.com/CallMeAlphabet/vZoom",
    "issues": "https://github.com/CallMeAlphabet/vZoom/issues"
  },
  "license": "Apache-2.0",
  "icon": "assets/vzoom/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.vzoom.range.FabricRangeBootstrap"
    ],
    "modmenu": [
      "com.vzoom.range.FabricRangeModMenu"
    ]
  },
  "mixins": [
    "vzoom.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "fabric-api": "*",
    "minecraft": ">=1.17 <1.20.7",
    "java": ">=16"
  },
  "suggests": {
    "modmenu": "*"
  }
}
